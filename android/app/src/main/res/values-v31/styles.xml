<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31): el sistema dibuja su propia pantalla de arranque
         con el ícono de la app. Su fondo toma el mismo tono del splash de
         Flutter (antes era blanco); el ícono no cambia. -->
    <style name="LaunchTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/fondo_lanzamiento</item>
    </style>
</resources>
