<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 o más nuevo (#217): ni el respaldo en la nube ni la transferencia
  de un celular a otro copian los datos de la app. Ahí viven la sesión y los
  datos personales; android:allowBackup="false" ya apaga el respaldo en la
  nube, pero desde Android 12 no frena la transferencia entre celulares.
  Cifrados con la llave del Keystore del celular original, en otro celular no
  se podrían leer: la app nueva empieza sin sesión.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
