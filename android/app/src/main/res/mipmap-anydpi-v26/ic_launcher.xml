<?xml version="1.0" encoding="utf-8"?>
<!-- Ícono adaptable de Android 8+ (#327): el diseño del ícono de la ficha de
     Play. Fondo verde olivo de la marca y, como primer plano, el pastel con
     «PIER» en dorado dentro de la zona segura (círculo de 66 dp de los
     108 dp), para que ninguna máscara del launcher lo corte. Android 7 o
     anterior usa mipmap-*/ic_launcher.png. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
